# Copia questo file in .env e personalizza i valori prima di avviare
# `docker compose up`. Il file .env non va mai versionato in Git.

# --- PostgreSQL ---
POSTGRES_USER=gestionale
POSTGRES_PASSWORD=changeme_dev_password
POSTGRES_DB=gestionale
POSTGRES_PORT=5432

# --- Backend ---
DATABASE_URL=postgresql+psycopg://gestionale:changeme_dev_password@db:5432/gestionale
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:3000"]
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=/data/storage

# --- Frontend ---
FRONTEND_PORT=3000
# Usato dal browser dell'utente (fuori dai container)
NEXT_PUBLIC_API_URL=http://localhost:8000
# Usato dal server Next.js dentro il container (rete Docker interna)
API_URL_INTERNAL=http://backend:8000
